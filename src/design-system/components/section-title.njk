{# Centered section title with orange rules on both sides (vertically centered to the text).
   On mobile the rules + spacers are hidden (see head.njk .st-*), leaving just the centered,
   full-width title text — so a long title ("WHY PARTNER WITH COMACPRO?") no longer squeezes the
   rules to nothing. Desktop / Outlook keep the rules. #}
{% macro sectionTitle(text, tokens) %}
<mj-section padding="22px 24px 8px 24px">
  <mj-column>
    <mj-table width="100%" role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td class="st-side">&nbsp;</td>
        <td class="st-rule" width="34" valign="middle" style="font-size:0;line-height:0;"><div style="border-top:2px solid {$ tokens.color.orange $};font-size:0;line-height:0;">&#8202;</div></td>
        <td class="st-text" style="width:1%;white-space:nowrap;padding:0 14px;font-family:{$ tokens.font.stack $};font-size:16px;font-weight:700;letter-spacing:0.5px;color:{$ tokens.color.navy $};text-align:center;">{$ text $}</td>
        <td class="st-rule" width="34" valign="middle" style="font-size:0;line-height:0;"><div style="border-top:2px solid {$ tokens.color.orange $};font-size:0;line-height:0;">&#8202;</div></td>
        <td class="st-side">&nbsp;</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
{% endmacro %}
