{# Centered section title + a short centered orange rule BELOW it. Replaces the old
   [rule][text][rule] table, which relied on width:1% + white-space:nowrap: Outlook's Word engine
   took the 1% literally and wrapped the title one character per line, and on mobile the rules got
   squeezed to nothing. This layout wraps cleanly at any width and is Outlook-safe — mj-text and
   mj-divider are plain table / VML primitives, no shrink-to-fit trickery. #}
{% macro sectionTitle(text, tokens) %}
<mj-section padding="22px 24px 8px 24px">
  <mj-column>
    <mj-text align="center" color="{$ tokens.color.navy $}" font-size="16px" font-weight="700" line-height="1.3" padding="0"><span style="letter-spacing:0.5px;">{$ text $}</span></mj-text>
    <mj-divider border-width="2px" border-color="{$ tokens.color.orange $}" width="36px" align="center" padding="10px 0 0 0" />
  </mj-column>
</mj-section>
{% endmacro %}
