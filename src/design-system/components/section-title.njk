{# Centered section title with orange rules on both sides, vertically centered to the text. #}
{% macro sectionTitle(text, tokens) %}
<mj-section padding="28px 24px 8px 24px">
  <mj-column>
    <mj-table width="100%" role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td>&nbsp;</td>
        <td width="34" valign="middle" style="font-size:0;line-height:0;"><div style="border-top:2px solid {$ tokens.color.orange $};font-size:0;line-height:0;">&#8202;</div></td>
        <td style="width:1%;white-space:nowrap;padding:0 14px;font-family:{$ tokens.font.stack $};font-size:16px;font-weight:700;letter-spacing:0.5px;color:{$ tokens.color.navy $};">{$ text $}</td>
        <td width="34" valign="middle" style="font-size:0;line-height:0;"><div style="border-top:2px solid {$ tokens.color.orange $};font-size:0;line-height:0;">&#8202;</div></td>
        <td>&nbsp;</td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
{% endmacro %}
