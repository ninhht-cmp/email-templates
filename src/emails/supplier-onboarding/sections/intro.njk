{# Intro: greeting + opening paragraphs (merge tags filled at send time). #}
<mj-section padding="32px 32px 8px 32px">
  <mj-column>
    <mj-text color="{$ tokens.color.heading $}" font-size="18px" font-weight="700" padding="0 0 16px 0">
      Dear {{company_name}},
    </mj-text>
    <mj-text padding="0 0 16px 0">
      I'm {{sender_name}}, {{sender_title}} at COMACPRO. While researching construction
      equipment suppliers, we reviewed your product portfolio and were impressed by several
      categories that align well with current buyer demand in Vietnam and Southeast Asia.
    </mj-text>
    <mj-text css-class="link-orange" padding="0">
      We would be pleased to welcome your company as an official supplier on
      <a href="https://comacpro.net/">comacpro.net</a>.
    </mj-text>
  </mj-column>
</mj-section>
