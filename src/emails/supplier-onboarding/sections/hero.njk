{# Hero: full-bleed machinery photo (mj-section background-url, VML for Outlook) with logo + copy
   over it. Legibility comes from a white scrim BAKED into a SINGLE desktop-crop asset
   (content.assets.hero) — no CSS overlay and no media-query image swap (Gmail ignores CSS
   background-image swaps and strips <style> on non-Google accounts, so a per-width swap can't be
   relied on). The scrim fades left→right, so it's crisp on DESKTOP where the copy sits in the left
   56% column. KNOWN TRADE-OFF: on mobile the columns stack and the text spans FULL width over the
   desktop scrim, so the right of long lines can fall over the busier photo — weaker legibility,
   Gmail especially. The only real fix is in the asset: re-bake a wider/heavier scrim on a
   desktop-ratio image and point content.assets.hero at it (option A). Section background-color is
   white to match the scrim, so an image-blocked inbox still reads dark text on light. #}
<mj-section css-class="hero-bg" background-url="{$ content.assets.hero $}" background-size="cover"
            background-position="left center" background-repeat="no-repeat"
            background-color="{$ tokens.color.white $}" padding="0">
  {# `fluid` = inline max-width read from MJML's own ghost-table width at build time. Keeps the 56/44
     split side-by-side on New Outlook / Outlook webml (no media query needed), and confines the copy
     to its box on mobile so it stays over the left scrim, not the busy centre. #}
  <mj-column css-class="hero-s-col fluid" width="56%" vertical-align="middle" padding="24px 8px 24px 32px">
    <mj-image align="left" width="128px" height="auto" src="{$ content.assets.logo $}" alt="COMACPRO" padding="0 0 14px 0" />
    <mj-text color="{$ tokens.color.heroTitle $}" font-size="24px" font-weight="600" line-height="1.25" padding="0">
      {$ content.hero.heading $}
    </mj-text>
    <mj-divider border-width="3px" border-color="{$ tokens.color.orange $}" width="52px" align="left" padding="14px 0 14px 0" />
    <mj-text color="{$ tokens.color.body $}" font-size="13px" line-height="1.5" padding="0">
      {$ content.hero.subline | replace('{brand}', '<span class="brand">COMACPRO</span>') | safe $}
    </mj-text>
  </mj-column>
  <mj-column css-class="hero-s-col fluid" width="44%" vertical-align="middle" padding="0">
    <mj-text padding="0">&#8202;</mj-text>
  </mj-column>
</mj-section>
