{# Hero: full-bleed machinery photo (mj-section background-url, VML for Outlook) with logo + copy
   over it. Legibility comes from a white WASH baked into a SINGLE hero asset (content.assets.hero) —
   not a CSS overlay and not a media-query image swap. Gmail (app + web) ignores CSS background-image
   swaps and strips <style> on non-Google accounts, so one wash-baked image is used for every client
   and every width: the dark-blue text stays legible whether it sits in the 56% desktop column or
   stacks full-width on mobile. The section background-color is white to match the wash, so an
   image-blocked inbox still reads dark text on light. (A lighter left→right-fade desktop crop looked
   sharper on desktop but was unreadable on Gmail mobile, where text stacks full-width — see git.) #}
<mj-section css-class="hero-bg" background-url="{$ content.assets.hero $}" background-size="cover"
            background-position="left center" background-repeat="no-repeat"
            background-color="{$ tokens.color.white $}" padding="0">
  <mj-column width="56%" vertical-align="middle" padding="24px 8px 24px 32px">
    <mj-image align="left" width="128px" height="auto" src="{$ content.assets.logo $}" alt="COMACPRO" padding="0 0 14px 0" />
    <mj-text color="{$ tokens.color.heroTitle $}" font-size="24px" font-weight="600" line-height="1.25" padding="0">
      {$ content.hero.heading $}
    </mj-text>
    <mj-divider border-width="3px" border-color="{$ tokens.color.orange $}" width="52px" align="left" padding="14px 0 14px 0" />
    <mj-text color="{$ tokens.color.body $}" font-size="13px" line-height="1.5" padding="0">
      {$ content.hero.subline | replace('{brand}', '<span class="brand">COMACPRO</span>') | safe $}
    </mj-text>
  </mj-column>
  <mj-column width="44%" vertical-align="middle" padding="0">
    <mj-text padding="0">&#8202;</mj-text>
  </mj-column>
</mj-section>
