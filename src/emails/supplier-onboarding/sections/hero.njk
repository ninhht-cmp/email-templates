{# Hero: full-bleed machinery photo (mj-section background-url, VML for Outlook) with the logo +
   copy over its light left. The white left→right fade that keeps the dark-blue text legible is
   BAKED INTO the hero asset (see README → "Baking the hero scrim"), not a CSS overlay — so it
   renders in EVERY client (Gmail + Outlook included), which a `<style>` gradient did not. The
   section background-color is white to match the baked scrim, so an image-blocked inbox still
   reads dark text on light. #}
{# background-position is LEFT, not center: cover crops the sides on a narrow screen. On clients
   that strip <style> (Gmail app on non-Google accounts, "GANGA"), BOTH the min-width:480 layout
   rule and the max-width:479 mobile-scrim swap drop away — so the two columns fall back to inline
   width:100% and STACK, and the text column then spans the FULL width over the DESKTOP hero asset.
   Pinning the image left keeps the baked white scrim (left third) under at least the start of each
   line; the right of long wrapped lines can still land over the busier centre. That residual
   legibility case is fixable only in the asset (bake a wider scrim), not in CSS — verify on a real
   GANGA render before deciding. On the 600px desktop the image is exactly 600 wide, so position is
   a no-op there. #}
<mj-section css-class="hero-bg" background-url="{$ content.assets.hero $}" background-size="cover"
            background-position="left center" background-repeat="no-repeat"
            background-color="{$ tokens.color.white $}" padding="0">
  <mj-column width="56%" vertical-align="middle" padding="24px 8px 24px 32px">
    <mj-image align="left" width="128px" height="auto" src="{$ content.assets.logo $}" alt="COMACPRO" padding="0 0 14px 0" />
    <mj-text color="{$ tokens.color.heroTitle $}" font-size="24px" font-weight="600" line-height="1.25" padding="0">
      {$ content.hero.heading $}
    </mj-text>
    <mj-divider border-width="3px" border-color="{$ tokens.color.orange $}" width="52px" align="left" padding="14px 0 14px 0" />
    <mj-text color="{$ tokens.color.body $}" font-size="13px" line-height="1.5" padding="0">
      {$ content.hero.subline | replace('{brand}', '<span class="brand">COMACPRO</span>') | safe $}
    </mj-text>
  </mj-column>
  <mj-column width="44%" vertical-align="middle" padding="0">
    <mj-text padding="0">&#8202;</mj-text>
  </mj-column>
</mj-section>
