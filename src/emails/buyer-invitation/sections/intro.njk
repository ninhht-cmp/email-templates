{#
  Intro: greeting + opening paragraphs (merge tags filled at send time) + divider.

  BUYER voice — deliberately different from supplier-onboarding/sections/intro.njk, which pitches
  the reader on becoming a supplier. This email is buyer-facing end to end (subject, hero, proof
  panel, both CTAs), so the intro has to match; the earlier supplier wording was inherited copy and
  contradicted everything around it.
#}
<mj-section padding="26px 32px 8px 32px">
  <mj-column>
    <mj-text color="{$ tokens.color.heading $}" font-size="17px" font-weight="700" padding="0 0 14px 0">
      Dear {{company_name}},
    </mj-text>
    <mj-text padding="0 0 16px 0">
      I'm {{sender_name}}, {{sender_title}} at COMACPRO. We help contractors and equipment
      buyers across Vietnam and Southeast Asia source reliable used construction machinery —
      verified suppliers, transparent specs, and shipping handled end to end.
    </mj-text>
    <mj-text css-class="link-orange" padding="0">
      If you have projects coming up, you can browse current stock on
      <a href="https://comacpro.net/">comacpro.net</a>.
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding="20px 32px 0 32px">
  <mj-column><mj-divider border-width="1px" border-color="{$ tokens.color.divider $}" padding="0" /></mj-column>
</mj-section>
